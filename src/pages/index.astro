---
// Static shell; data comes from /events.json written by scripts/crawl.mjs — no rebuild needed while the crawler runs.
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Dhaka Happening — today &amp; tomorrow</title>
    <style>
      :root { --ink: #1a1a2e; --mut: #66708a; --line: #e4e4ee; --acc: #0f766e; }
      * { box-sizing: border-box; }
      body { margin: 0; font: 16px/1.55 system-ui, sans-serif; color: var(--ink); background: #fafaff; }
      header { padding: 2rem 1rem 1rem; text-align: center; }
      h1 { margin: 0; font-size: 2rem; }
      #dates { color: var(--acc); font-weight: 600; margin: .4rem 0 0; }
      #meta { color: var(--mut); font-size: .85rem; margin: .2rem 0 0; }
      main { max-width: 1000px; margin: 0 auto; padding: 0 1rem 2rem; }
      section { margin: 2rem 0; }
      h2 { font-size: 1.25rem; border-bottom: 2px solid var(--line); padding-bottom: .3rem; }
      .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: .8rem; }
      .card { background: #fff; border: 1px solid var(--line); border-radius: 10px; padding: .9rem 1rem; }
      .card a { color: var(--ink); font-weight: 600; text-decoration: none; }
      .card a:hover { color: var(--acc); }
      .card p { margin: .4rem 0; color: #444; font-size: .92rem; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
      .card .src { color: var(--mut); font-size: .78rem; }
      .empty { color: var(--mut); font-style: italic; }
      footer { max-width: 1000px; margin: 0 auto; padding: 1rem; color: var(--mut); font-size: .8rem; border-top: 1px solid var(--line); }
    </style>
  </head>
  <body>
    <header>
      <h1>Dhaka Happening</h1>
      <p id="dates"></p>
      <p id="meta">loading…</p>
    </header>
    <main>
      <section><h2>Happening today</h2><div class="grid" id="today"></div></section>
      <section><h2>Tomorrow in Dhaka</h2><div class="grid" id="tomorrow"></div></section>
      <section><h2>Possibly relevant — no date in the headline</h2><div class="grid" id="nodate"></div></section>
    </main>
    <footer id="sources"></footer>
    <script>
      const $ = id => document.getElementById(id);
      const esc = s => String(s ?? '').replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
      const fmtDate = d => new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Dhaka', weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }).format(d);

      function card(ev) {
        const el = document.createElement('article');
        el.className = 'card';
        const when = ev.published ? ' · ' + new Date(ev.published).toLocaleString('en-GB', { timeZone: 'Asia/Dhaka', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) : '';
        el.innerHTML = `<a href="${esc(ev.url)}" target="_blank" rel="noopener">${esc(ev.title)}</a>`
          + (ev.summary ? `<p>${esc(ev.summary)}</p>` : '')
          + `<div class="src">${esc(ev.source)}${ev.cue ? ' · ' + ev.cue : ''}${when}</div>`;
        return el;
      }

      function fill(list, elId) {
        const box = $(elId);
        box.innerHTML = '';
        if (!list.length) { box.innerHTML = '<p class="empty">nothing tagged yet — the crawler is still collecting</p>'; return; }
        for (const ev of list) box.appendChild(card(ev));
      }

      async function load() {
        try {
          const data = await (await fetch('events.json', { cache: 'no-store' })).json(); // relative: works under any Pages base path
          $('dates').textContent = `Today · ${fmtDate(new Date())} — Tomorrow · ${fmtDate(new Date(Date.now() + 86400000))}`;
          $('meta').textContent = `${data.today.length} today · ${data.tomorrow.length} tomorrow · ${data.noDate.length} unsorted · data refreshed `
            + new Date(data.generatedAt).toLocaleTimeString('en-GB', { timeZone: 'Asia/Dhaka' });
          fill(data.today, 'today');
          fill(data.tomorrow, 'tomorrow');
          fill(data.noDate, 'nodate');
          $('sources').innerHTML = 'sources: ' + data.sources.map(s => `${esc(s.name)}${s.ok ? '' : ' (down)'}`).join(' · ')
            + ' — auto-refreshes every 5 min';
        } catch {
          $('meta').textContent = 'could not load events.json — run `npm run crawl:once` first';
        }
      }
      load();
      setInterval(load, 5 * 60 * 1000);
    </script>
  </body>
</html>
