---
// Fully static: cards are rendered at build time from public/events.json (crawl → curate → push → CI builds).
// No client JS — the data only ever changes at deploy time, so there is nothing to refresh at runtime.
import { readFileSync } from 'node:fs';

let data = { today: [], tomorrow: [], noDate: [], sources: [], generatedAt: null };
try {
  data = { ...data, ...JSON.parse(readFileSync(new URL('../../public/events.json', import.meta.url), 'utf8')) };
} catch { /* no crawl yet — page builds with empty sections */ }

// Google News titles end with " - Publisher"; cut at the last " - " (publisher names may contain hyphens).
const isGoogle = ev => ev.source.startsWith('Google News');
const cleanTitle = ev => {
  if (!isGoogle(ev)) return ev.title;
  const i = ev.title.lastIndexOf(' - ');
  return i > 0 ? ev.title.slice(0, i) : ev.title;
};

const dhaka = opts => new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Dhaka', ...opts });
const snap = data.generatedAt ? new Date(data.generatedAt) : null;
const longDay = t => dhaka({ weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }).format(t);
const shortStamp = t => dhaka({ day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }).format(t);
const when = ev => ev.published ? ' · ' + shortStamp(new Date(ev.published)) : '';

const sections = [
  ['today', 'Today', snap ? longDay(snap.getTime()) : null],
  ['tomorrow', 'Tomorrow', snap ? longDay(snap.getTime() + 86400000) : null],
  ['noDate', 'No date given', null],
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Events in Dhaka today and tomorrow, aggregated from local news feeds." />
    <title>Dhaka Happening — today &amp; tomorrow</title>
    <!-- is:global: styles must apply to build-time markup freely; nothing here is runtime-scoped -->
    <style is:global>
      :root {
        --bg: #f5f6f8; --card: #ffffff; --ink: #16181d; --mut: #6b7280;
        --line: #e5e7eb; --acc: #0f766e; --acc-soft: rgba(15, 118, 110, .08);
        --shadow: 0 1px 2px rgba(16, 24, 40, .05);
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #0f1115; --card: #171a20; --ink: #e7e9ee; --mut: #9aa1ad;
          --line: #262b33; --acc: #2dd4bf; --acc-soft: rgba(45, 212, 191, .1);
          --shadow: 0 1px 2px rgba(0, 0, 0, .3);
        }
      }
      * { box-sizing: border-box; }
      body {
        margin: 0; background: var(--bg); color: var(--ink);
        font: 16px/1.6 system-ui, -apple-system, "Segoe UI", Roboto, "Noto Sans", "Noto Sans Bengali", sans-serif;
        -webkit-font-smoothing: antialiased;
      }
      a { color: var(--acc); }
      a:focus-visible { outline: 2px solid var(--acc); outline-offset: 2px; border-radius: 4px; }

      header { max-width: 1060px; margin: 0 auto; padding: 2.5rem 1rem 1.25rem; text-align: center; }
      h1 { margin: 0; font-size: 1.9rem; font-weight: 700; letter-spacing: -.02em; }
      #meta { margin: .25rem 0 0; color: var(--mut); font-size: .85rem; }
      #dates { margin: 1rem 0 0; display: flex; gap: .5rem; justify-content: center; flex-wrap: wrap; }
      .chip {
        padding: .35rem .8rem; border: 1px solid var(--line); border-radius: 999px;
        background: var(--card); font-size: .85rem; font-weight: 600; box-shadow: var(--shadow);
      }
      .chip b { color: var(--acc); font-weight: 600; margin-right: .35rem; }

      main { max-width: 1060px; margin: 0 auto; padding: 0 1rem 2rem; }
      section { margin: 1.75rem 0; }
      h2 {
        margin: 0 0 .75rem; font-size: .95rem; font-weight: 600; letter-spacing: .05em;
        text-transform: uppercase; color: var(--mut);
        display: flex; align-items: center; gap: .5rem;
      }
      h2 .count {
        background: var(--acc-soft); color: var(--acc); border-radius: 999px;
        font-size: .75rem; padding: .1rem .55rem; letter-spacing: 0;
      }
      .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: .75rem; }

      .card {
        display: flex; flex-direction: column; gap: .45rem;
        background: var(--card); border: 1px solid var(--line); border-radius: 14px;
        padding: 1rem 1.1rem; box-shadow: var(--shadow);
        transition: border-color .15s ease, transform .15s ease, box-shadow .15s ease;
      }
      .card:hover { border-color: var(--acc); transform: translateY(-2px); box-shadow: 0 4px 12px rgba(16, 24, 40, .08); }
      .card a { color: var(--ink); font-weight: 600; text-decoration: none; line-height: 1.4; }
      .card a:hover { color: var(--acc); }
      .card p {
        margin: 0; color: var(--mut); font-size: .92rem;
        display: -webkit-box; -webkit-line-clamp: 3; line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
      }
      .card .src { color: var(--mut); font-size: .78rem; margin-top: auto; }

      .empty {
        grid-column: 1 / -1; text-align: center; color: var(--mut); font-size: .9rem;
        border: 1px dashed var(--line); border-radius: 14px; padding: 1.5rem 1rem; margin: 0;
      }

      footer {
        max-width: 1060px; margin: 0 auto; padding: 1.25rem 1rem 2rem; text-align: center;
        color: var(--mut); font-size: .8rem; border-top: 1px solid var(--line);
      }
    </style>
  </head>
  <body>
    <header>
      <h1>Dhaka Happening</h1>
      <p id="meta">{snap ? `snapshot taken ${shortStamp(snap)} Dhaka` : 'no data yet — run `npm run crawl:once`'}</p>
      {snap && (
        <p id="dates">
          <span class="chip"><b>Today</b>{longDay(snap.getTime())}</span>
          <span class="chip"><b>Tomorrow</b>{longDay(snap.getTime() + 86400000)}</span>
        </p>
      )}
    </header>
    <main>
      {sections.map(([key, label, sub]) => (
        <section>
          <h2>{label}{sub && ` — ${sub}`} <span class="count">{data[key].length || ''}</span></h2>
          <div class="grid">
            {data[key].length ? data[key].map(ev => (
              <article class="card">
                <a href={ev.url} target="_blank" rel="noopener">{cleanTitle(ev)}</a>
                {!isGoogle(ev) && ev.summary && <p>{ev.summary}</p>}
                <div class="src">{ev.source}{when(ev)}</div>
              </article>
            )) : <p class="empty">nothing here right now</p>}
          </div>
        </section>
      ))}
    </main>
    <footer>
      {data.sources.length ? `sources: ${data.sources.map(s => s.name + (s.ok ? '' : ' (down)')).join(' · ')} — rebuilt on every deploy` : ''}
    </footer>
  </body>
</html>
